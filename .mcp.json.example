{
  "mcpServers": {
    "glance": {
      "type": "http",
      "url": "http://localhost:8088/mcp",
      "headers": {
        "X-Api-Token": "<API_TOKEN from .env>"
      }
    },
    "glance-remote": {
      "type": "http",
      "url": "https://dash.example.com/mcp",
      "headers": {
        "X-Api-Token": "<API_TOKEN from .env>"
      }
    }
  }
}
