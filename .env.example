# Copy to .env and fill in. Never commit the real .env.

# Shared secret for the token-protected API and MCP (X-Api-Token).
# Generate one: openssl rand -hex 32
API_TOKEN=

# --- Nextcloud (home calendar + tasks) ---
# Public read-only ICS share of the home calendar
ICS_URL=https://nextcloud.example.com/remote.php/dav/public-calendars/XXXXXXXX?export
# Writable CalDAV collection for creating/editing home events
CAL_URL=https://nextcloud.example.com/remote.php/dav/calendars/USER/personal/
ICS_USER=
ICS_PASS=
# base64("user:password"), used for task creation
NEXTCLOUD_BTOA=
# CalDAV URLs of the two task lists (see README, "Nextcloud Tasks setup")
TASKS_HOME_URL=https://nextcloud.example.com/remote.php/dav/calendars/USER/home-tasks/?export
TASKS_WORK_URL=https://nextcloud.example.com/remote.php/dav/calendars/USER/work-tasks/?export

# --- Exchange (work calendar, EWS/NTLM) ---
EWS_URL=https://mail.example.com/EWS/Exchange.asmx
EWS_USER=
EWS_PASS=
EWS_DOMAIN=

# --- Proxy cache ---
ICS_CACHE_TTL_MS=300000
ICS_LIMIT=10

# --- Glance login ---
GLANCE_SECRET_KEY=
# bcrypt hash of the login password
GLANCE_PASSWORD_HASH=

# --- Published calendar feed (optional) ---
# Token guarding the read-only .ics feed this serves. Treat it as a
# credential: anyone who has it can read the calendar.
CALENDAR_FEED_TOKEN=

# --- Spotify widget (optional; see README, "Refresh tokens") ---
# base64("client_id:client_secret")
SPOTIFY_BTOA=
SPOTIFY_REFRESH=

# --- Email digests (optional) ---
DIGEST_ENABLED=false
DIGEST_TO=
DIGEST_CRON=0 8 * * *
DIGEST_TZ=Europe/Berlin
DIGEST_PRIORITY=high
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WEEKLY_DIGEST_ENABLED=false
WEEKLY_DIGEST_TO=
WEEKLY_DIGEST_CRON=0 8 * * 1

# --- ntfy push notifications (optional) ---
NTFY_URL=https://ntfy.sh
# The topic is itself a capability: anyone who knows it can publish to
# it. Use an unguessable one.
NTFY_TOPIC=
# Only needed for a self-hosted ntfy with auth enabled
NTFY_TOKEN=

# --- Strava (optional, read-only; see README, "Refresh tokens") ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
# Annual goals in km; 0 disables the goal bar
STRAVA_GOAL_RUN_KM=0
STRAVA_GOAL_RIDE_KM=0
STRAVA_GOAL_SWIM_KM=0

# --- Garmin Connect (optional) ---
GARMIN_EMAIL=
GARMIN_PASSWORD=

# --- SiYuan notes (optional) ---
SIYUAN_URL=http://siyuan-note:6806
SIYUAN_TOKEN=
SIYUAN_NOTEBOOK_NAME=

# --- Weather (Open-Meteo, no key needed) ---
WEATHER_LOCATION=Berlin, Germany

# --- openGym (optional; the vendored gym app, see .gitignore) ---
# WebAuthn relying-party ID and origin - must match the hostname the
# gym is served on, or passkeys will not validate.
GYM_RP_ID=gym.example.com
GYM_ORIGIN=https://gym.example.com
GYM_WEB_PORT=8090
# Comma-separated user IDs granted admin
GYM_ADMIN_UIDS=
GYM_INVITE_ONLY=1
GYM_ALLOW_GUEST=0
# User ID the MCP server acts as
GYM_MCP_UID=

# --- OAuth resource server for claude.ai web connectors (optional; see mcp.md) ---
OIDC_ISSUER=
OIDC_CLIENT_ID=
PUBLIC_BASE=
MCP_RESOURCE=
