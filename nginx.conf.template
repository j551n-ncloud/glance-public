events {}

http {
  # Cloudflare fronts this origin and pools/reuses connections to it; nginx's
  # compiled-in default keepalive_timeout (75s) is shorter than Cloudflare's
  # idle-connection-reuse window under low traffic, so a request occasionally
  # goes out over a connection nginx already closed -> immediate reset on the
  # first try, instant success on retry (a fresh connection). Keep this above
  # Cloudflare's reuse window so nginx never closes first.
  keepalive_timeout 120s;

  server {
    listen 80;

    # Calendar/task API paths.
    # POST: passed through; ics-proxy enforces the X-Api-Token itself.
    # GET:  denied unless the request carries the correct X-Api-Token.
    #       (Glance widgets read GET endpoints directly over the Docker
    #        network, bypassing nginx, so they are unaffected.)
    location /ews-api/ {
      set $api_ok 0;
      if ($request_method = POST) { set $api_ok 1; }
      if ($http_x_api_token = "${API_TOKEN}") { set $api_ok 1; }
      if ($api_ok = 0) { return 403; }
      proxy_pass http://ics-proxy:3000/;
      proxy_set_header Host $host;
    }

    location /tasks-api/ {
      set $api_ok 0;
      if ($request_method = POST) { set $api_ok 1; }
      if ($http_x_api_token = "${API_TOKEN}") { set $api_ok 1; }
      if ($api_ok = 0) { return 403; }
      proxy_pass http://ics-proxy:3000/;
      proxy_set_header Host $host;
    }

    # ICS calendar-feed export (read-only Exchange-calendar subscription for
    # Nextcloud etc.). Deliberately NOT gated by X-Api-Token here — a
    # subscription client can't send custom headers. ics-proxy itself checks
    # the ?token= query param (CALENDAR_FEED_TOKEN); see CLAUDE.md.
    location /calendar-feed.ics {
      proxy_pass http://ics-proxy:3000/calendar-feed.ics;
      proxy_set_header Host $host;
    }

    # Nextcloud Deck read API (read-only; token required for every request).
    location /deck-api/ {
      if ($http_x_api_token != "${API_TOKEN}") { return 403; }
      proxy_pass http://ics-proxy:3000/deck/;
      proxy_set_header Host $host;
    }

    # Bike maintenance API (token required for every request, GET and POST
    # alike — same model as Deck, since the reset write also lives under
    # this prefix). The Glance widget reads ics-proxy directly and bypasses
    # this location.
    location /bike-api/ {
      if ($http_x_api_token != "${API_TOKEN}") { return 403; }
      proxy_pass http://ics-proxy:3000/bike/;
      proxy_set_header Host $host;
    }

    # Strava read API (read-only; token required for every request). The
    # Glance widget reads ics-proxy directly over the Docker network and
    # bypasses this location.
    location /strava-api/ {
      if ($http_x_api_token != "${API_TOKEN}") { return 403; }
      proxy_pass http://ics-proxy:3000/strava/;
      proxy_set_header Host $host;
    }

    # Garmin Connect workout API (token required for every request, GET and
    # POST alike -- same model as Deck/bike-api, since these are all writes
    # or write-adjacent). No Glance widget reads this, so no bypass needed.
    location /garmin-api/ {
      if ($http_x_api_token != "${API_TOKEN}") { return 403; }
      proxy_pass http://ics-proxy:3000/garmin/;
      proxy_set_header Host $host;
    }

    # SiYuan Note API, scoped to one dedicated notebook (token required for every request).
    location /siyuan-api/ {
      if ($http_x_api_token != "${API_TOKEN}") { return 403; }
      proxy_pass http://ics-proxy:3000/siyuan/;
      proxy_set_header Host $host;
    }

    # Apple Health API. POST /health-api/ingest is passed through (ics-proxy
    # enforces the token); GET reads require the token here. Prefix preserved.
    location /health-api/ {
      set $api_ok 0;
      if ($request_method = POST) { set $api_ok 1; }
      if ($http_x_api_token = "${API_TOKEN}") { set $api_ok 1; }
      if ($api_ok = 0) { return 403; }
      client_max_body_size 25m;
      proxy_pass http://ics-proxy:3000/health-api/;
      proxy_set_header Host $host;
    }

    # OAuth Protected Resource Metadata (RFC 9728), public so claude.ai can
    # discover the authorization server (Pocket ID) before it has a token.
    location /.well-known/oauth-protected-resource {
      proxy_pass http://mcp:3001;
      proxy_set_header Host $host;
    }

    # MCP server (Streamable HTTP). Auth is enforced by the mcp service itself:
    # X-Api-Token (Claude Code) OR a Pocket ID Bearer JWT (claude.ai web). nginx
    # passes everything through so the 401 + WWW-Authenticate OAuth dance works.
    location /mcp {
      proxy_pass http://mcp:3001;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_set_header Authorization $http_authorization;
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    # Live widget updates (server-sent events). Needs buffering disabled and a
    # long read timeout, otherwise nginx holds the stream until its buffer
    # fills or the connection closes and updates never reach the browser.
    location /api/sse/ {
      proxy_pass http://glance:8080;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      proxy_set_header Host $host;
      proxy_buffering off;
      proxy_read_timeout 3600s;
    }

    location / {
      proxy_pass http://glance:8080;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
